VITE_OG_DESCRIPTION="Invitación formal al festejo de 15 años de Catalina. Sábado 28 de Noviembre de 2026 • 20:30 hs. Salón Quintana, Chacabuco."

# ==========================================
# 9. AYUDA VISUAL DE SCROLL (MOBILE SWIPE HINT)
# ==========================================
# Activar o desactivar la animación de ayuda visual ("true" o "false")
VITE_SCROLL_HINT_ENABLED="true"

# Tiempo en milisegundos tras ingresar al Hero para mostrar la primera ayuda (por defecto: 3000 = 3 seg)
VITE_SCROLL_HINT_INITIAL_DELAY_MS="3000"

# Tiempo en milisegundos para repetir la ayuda si el usuario permanece en el Hero sin scrollear (por defecto: 10000 = 10 seg)
VITE_SCROLL_HINT_REPEAT_DELAY_MS="10000"

# Tiempo de permanencia de la ayuda visual en pantalla antes de desvanecerse (en milisegundos, por defecto: 2800 = 2.8 seg)
VITE_SCROLL_HINT_DURATION_MS="2800"

# Umbral en píxeles de scroll o arrastre vertical para desactivar permanentemente la ayuda (por defecto: 120)
# Evita desactivaciones accidentales por micro-desplazamientos de 1 o 2 píxeles
VITE_SCROLL_HINT_DISMISS_THRESHOLD_PX="120"

# Distancia en píxeles que la pantalla se desplaza hacia abajo (peek) y regresa para inducir el scroll (por defecto: 140)
VITE_SCROLL_HINT_PEEK_DISTANCE="140"

# Limitar la ayuda exclusivamente a dispositivos móviles/táctiles ("true" o "false", default: "true")
VITE_SCROLL_HINT_MOBILE_ONLY="true"
