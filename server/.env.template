# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (cata15web-server)
# ==============================================================================

# Puerto en el que escucha el servidor localmente
PORT=3002

# Origen permitido para CORS (en desarrollo '*' o 'http://localhost:5173')
CORS_ORIGIN=*

# Entorno de ejecución ('development' | 'production')
NODE_ENV=development

# ==============================================================================
# INTEGRACIÓN CON GOOGLE SHEETS
# ==============================================================================
# ID de la planilla de Google Sheets (extraído de la URL pública provista)
# https://docs.google.com/spreadsheets/d/1u7LT_cZn-SUzWxPNg1MZfPi0wsJNZfeUgEoilp0wemo/edit
GOOGLE_SHEET_ID=1u7LT_cZn-SUzWxPNg1MZfPi0wsJNZfeUgEoilp0wemo

# Nombre de la pestaña u hoja dentro del documento donde se insertan las respuestas
GOOGLE_SHEET_NAME=Respuestas

# ------------------------------------------------------------------------------
# OPCIÓN A (Recomendada y más rápida): Google Apps Script Webhook
# ------------------------------------------------------------------------------
# URL del Webhook generado tras implementar el script de docs/google-apps-script.js
# en Extensiones > Apps Script de la hoja de cálculo.
# Ejemplo: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_APPS_SCRIPT_URL=

# ------------------------------------------------------------------------------
# OPCIÓN B: Google Cloud Service Account Oficial (API v4)
# ------------------------------------------------------------------------------
# Correo de la cuenta de servicio creada en Google Cloud Console
# Ejemplo: cata15-bot@proyecto-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada RSA de la cuenta de servicio (con saltos de línea \n intactos)
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
