# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DEL SERVIDOR BACKEND (server/.env.template)
# Copiá este archivo a server/.env para configurar tu entorno local
# ==============================================================================

# Puerto local del servidor (por defecto 3002)
PORT=3002

# Origen permitido para CORS (usar '*' o 'http://localhost:5173')
CORS_ORIGIN=*

# Entorno de ejecución ('development' | 'production')
NODE_ENV=development

# ==============================================================================
# INTEGRACIÓN CON GOOGLE SHEETS
# Planilla provista: https://docs.google.com/spreadsheets/d/1u7LT_cZn-SUzWxPNg1MZfPi0wsJNZfeUgEoilp0wemo/edit
# ==============================================================================
# ID extraído de la URL pública de la planilla de Google Sheets
GOOGLE_SHEET_ID=1u7LT_cZn-SUzWxPNg1MZfPi0wsJNZfeUgEoilp0wemo

# Nombre de la pestaña u hoja dentro del documento donde se insertan las filas
GOOGLE_SHEET_NAME=Respuestas

# ------------------------------------------------------------------------------
# MÉTODO 1 (Recomendado): Google Apps Script Webhook
# ------------------------------------------------------------------------------
# URL del Webhook generado tras implementar el script de docs/google-apps-script.js
# en Extensiones > Apps Script de la hoja de cálculo como Aplicación Web (acceso público).
# Ejemplo:
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx0123456789/exec
GOOGLE_APPS_SCRIPT_URL=

# ------------------------------------------------------------------------------
# MÉTODO 2: Google Cloud Service Account Oficial (API v4)
# ------------------------------------------------------------------------------
# Correo de la cuenta de servicio creada en Google Cloud Console (darle permisos de Editor a la hoja)
# Ejemplo:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=cata15-bot@proyecto-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada RSA de la cuenta de servicio (con saltos de línea \n intactos)
# Ejemplo:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
